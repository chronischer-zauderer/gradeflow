SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/autograder
SPRING_DATASOURCE_USERNAME=autograder
SPRING_DATASOURCE_PASSWORD=autograder

POSTGRES_DB=autograder
POSTGRES_USER=autograder
POSTGRES_PASSWORD=autograder
POSTGRES_PORT=5432

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=autograder
RABBITMQ_PASSWORD=autograder
RABBITMQ_MANAGEMENT_PORT=15672

SERVER_PORT=8080

JWT_SECRET=gradeflow-local-development-secret-change-me-32
JWT_EXPIRATION_MS=86400000

SANDBOX_IMAGE=gradeflow-python-sandbox
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_MEMORY=256m
SANDBOX_MEMORY_SWAP=256m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_READ_ONLY=true
SANDBOX_TMPFS=/tmp:rw,noexec,nosuid,size=64m
